# Maintainer: Fredi Machado <fredisoft@gmail.com>
pkgname=omairc
pkgver=1.10.3
pkgrel=1
pkgdesc='Dead-simple IRC client for Omarchy'
arch=('x86_64')
url='https://github.com/fredimachado/omairc'
license=('MIT' 'LGPL-3.0-or-later' 'OFL-1.1')
options=(!debug)
depends=(
  'hicolor-icon-theme'
  'qt6-base'
  'qt6-declarative'
  'qt6-svg'
  'qt6-wayland'
  'qtkeychain-qt6'
  'xdg-desktop-portal'
)
makedepends=('python')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7bed0b68c3736a31a05254b2634844b37e989f625eceb239eff38e3073a82dd1')

build() {
  cd "$pkgname-$pkgver"
  qmake6 PREFIX=/usr
  make
}

check() {
  cd "$pkgname-$pkgver"
  ./bin/test
}

package() {
  cd "$pkgname-$pkgver"
  make INSTALL_ROOT="$pkgdir" install
}
